# Copy to .env and fill in. Do NOT commit .env.

# --- Phase 0 ---
# Host port 2345 = shared Postgres container.
DATABASE_URL="postgresql://postgres:postgres@localhost:2345/price_tracker?schema=public"
PORT=3000
# Number of reverse-proxy hops in front of the API (Render: 1). Leave unset
# locally — when set, the throttler keys on X-Forwarded-For.
# TRUST_PROXY=1
# Shared with web/ (same value): authenticates the BFF's X-Client-IP header so
# the throttler counts web users by their own IP. Generate: openssl rand -hex 32
# BFF_SECRET=
# Keep-alive self-ping against Render free-plan spin-down (health/keep-alive.service.ts).
# On by itself where Render sets RENDER_EXTERNAL_URL; KEEP_ALIVE_URL points it elsewhere.
# KEEP_ALIVE=false
# KEEP_ALIVE_INTERVAL_MIN=10

# --- Phase 1 (Auth) ---
# Generate strong random values for production, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Trial granted at registration (DESIGN.md §14.5).
TRIAL_DURATION_DAYS=30

# --- Phase 3 (Uploads / object storage) ---
# Any S3-compatible store. Prod = Cloudflare R2, local dev = MinIO (docker compose).
# Setup guide: docs/storage-r2.md
#
# Local MinIO (`docker compose up -d minio minio-init`):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_BUCKET="price-tracker-photos"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
#
# Cloudflare R2 (R2 → Manage API tokens → Object Read & Write on this bucket):
# STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_FORCE_PATH_STYLE="false"
# STORAGE_BUCKET="price-tracker-photos"
# STORAGE_ACCESS_KEY_ID="<R2 token Access Key ID>"
# STORAGE_SECRET_ACCESS_KEY="<R2 token Secret Access Key>"
