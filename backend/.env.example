# Copy to .env and fill in. Do NOT commit .env.

# --- Phase 0 ---
# Host port 2345 = shared Postgres container.
DATABASE_URL="postgresql://postgres:postgres@localhost:2345/price_tracker?schema=public"
PORT=3000

# --- Phase 1 (Auth) ---
# Generate strong random values for production, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Trial granted at registration (DESIGN.md §14.5).
TRIAL_DURATION_DAYS=30

# --- Phase 3 (Uploads / S3) ---
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="price-tracker-photos"
# Local dev uses MinIO (docker compose). For real AWS S3: drop the endpoint +
# force-path-style lines and rely on an IAM role (no keys) on EC2.
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_FORCE_PATH_STYLE="true"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
