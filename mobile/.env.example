# Base URL of the backend API (NestJS, global prefix /api/v1).
# A phone or emulator CANNOT reach the host's "localhost" — use the dev machine's LAN IP.
#   real device (same Wi-Fi): http://<your-LAN-IP>:3000/api/v1
#   Android emulator:         http://10.0.2.2:3000/api/v1
#   iOS simulator:            http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.x:3000/api/v1
