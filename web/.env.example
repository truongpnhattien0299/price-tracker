# Copy to .env.local.
# Server-only: the BFF (route handlers under src/app/api) calls the NestJS API.
# The browser never talks to it directly, so this must NOT be NEXT_PUBLIC_.
API_URL="http://localhost:3000/api/v1"
# Same value as the backend's BFF_SECRET. Lets the API throttle web users by
# their own IP instead of this server's. Optional locally.
BFF_SECRET=""

# Public, inlined into the client bundle.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Store listings for the landing page. Leave empty until the app is published:
# the buttons then show "Sắp có".
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_PLAY_STORE_URL=""
